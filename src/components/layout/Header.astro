---
/* src/components/layout/Header.astro */
import Search from "@astrojs/starlight/components/Search.astro";

const navigationItems = [
  {
    label: "Home",
    href: "/",
  },
  {
    label: "About CIC",
    href: "/wa-guide/#what-is-criminal-injuries-compensation",
  },
  {
    label: "How to apply",
    href: "/wa-guide/#how-do-i-apply",
  },
  {
    label: "For organisations",
    href: "/for-organisations/",
  },
  {
    label: "Support services",
    href: "/support-services/",
  },
] as const;
---

<nav id="site-navigation" class="print:hidden" aria-label="Primary navigation">
  <div class="site-navigation__inner">
    <a class="site-navigation__identity" href="/">
      <img
        src="/book.png"
        alt=""
        width="500"
        height="500"
        class="site-navigation__mark"
      />
      <span class="site-navigation__wordmark">
        <span>CIC</span>
        <span>Handbook</span>
      </span>
    </a>

    <button
      id="primary-navigation-toggle"
      class="site-navigation__toggle"
      type="button"
      aria-controls="primary-navigation-panel"
      aria-expanded="false"
      aria-label="Open navigation menu"
    >
      <svg
        data-menu-icon
        aria-hidden="true"
        focusable="false"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        data-close-icon
        class="hidden"
        aria-hidden="true"
        focusable="false"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>

    <div
      id="primary-navigation-panel"
      class="site-navigation__panel hidden"
    >
      <div class="site-navigation__links">
        {
          navigationItems.map((item) => (
            <a class="site-navigation__link" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </div>

      <div class="site-navigation__actions">
        <a
          class="site-navigation__quick-exit"
          href="https://www.google.com.au"
        >
          Quick Exit
        </a>
        <div class="site-navigation__search">
          <Search {...Astro.props} />
        </div>
      </div>
    </div>
  </div>
</nav>

<noscript>
  <style>
    @media (max-width: 67.499rem) {
      #primary-navigation-toggle {
        display: none !important;
      }

      #primary-navigation-panel {
        display: flex !important;
      }

      #primary-navigation-panel .site-navigation__search {
        display: none !important;
      }
    }
  </style>
</noscript>

<script>
  const menuButton = document.getElementById("primary-navigation-toggle");
  const menuPanel = document.getElementById("primary-navigation-panel");
  const menuIcon = menuButton?.querySelector<SVGElement>("[data-menu-icon]");
  const closeIcon = menuButton?.querySelector<SVGElement>("[data-close-icon]");
  const desktopNavigation = window.matchMedia("(min-width: 67.5rem)");
  let panelContainsFocus = false;

  function isMenuOpen() {
    return menuButton?.getAttribute("aria-expanded") === "true";
  }

  function setMenuState(open: boolean, restoreFocus = false) {
    if (!menuButton || !menuPanel) return;

    menuButton.setAttribute("aria-expanded", String(open));
    menuButton.setAttribute(
      "aria-label",
      open ? "Close navigation menu" : "Open navigation menu",
    );
    menuPanel.classList.toggle("hidden", !open);
    menuPanel.classList.toggle("flex", open);
    menuIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);

    if (!open && restoreFocus) {
      menuButton.focus();
    }
  }

  menuButton?.addEventListener("click", () => {
    setMenuState(!isMenuOpen());
  });

  menuPanel?.addEventListener("click", (event) => {
    if (desktopNavigation.matches) return;

    const target = event.target;
    if (target instanceof Element && target.closest("a")) {
      setMenuState(false, true);
    }
  });

  document.addEventListener("focusin", (event) => {
    const target = event.target;
    panelContainsFocus =
      target instanceof Node && Boolean(menuPanel?.contains(target));

    if (desktopNavigation.matches || !isMenuOpen() || !menuPanel) return;

    if (
      target instanceof Node &&
      target !== menuButton &&
      !menuPanel.contains(target)
    ) {
      setMenuState(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    const openSearchDialog = document.querySelector(
      "#site-navigation site-search dialog[open]",
    );
    if (openSearchDialog instanceof HTMLDialogElement) {
      event.preventDefault();
      openSearchDialog.close();
      openSearchDialog
        .closest("site-search")
        ?.querySelector<HTMLButtonElement>("button[data-open-modal]")
        ?.focus();
      return;
    }

    if (isMenuOpen()) {
      setMenuState(false, true);
    }
  });

  desktopNavigation.addEventListener("change", (event) => {
    const focusWillBeHidden =
      !event.matches &&
      (panelContainsFocus || menuPanel?.contains(document.activeElement));
    setMenuState(false, Boolean(focusWillBeHidden));
    panelContainsFocus = false;
  });
</script>

<style is:global>
  :root {
    --sl-nav-height: 4rem;
  }

  .page > header.header {
    overflow: visible;
    border-bottom: 0;
    padding: 0;
    background: var(--color-brand-warm-ivory);
  }

  #site-navigation {
    width: 100%;
    height: 100%;
    color: var(--color-brand-midnight-navy);
    font-family: var(--font-body);
  }

  .site-navigation__inner {
    position: relative;
    display: flex;
    width: 100%;
    max-width: var(--container-content);
    height: 100%;
    margin-inline: auto;
    padding-inline: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .site-navigation__identity {
    display: inline-flex;
    min-width: 0;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-brand-midnight-navy);
    text-decoration: none;
  }

  .site-navigation__mark {
    width: 2rem;
    height: 2rem;
    flex: none;
    object-fit: contain;
  }

  .site-navigation__wordmark {
    display: inline-flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .site-navigation__wordmark > :last-child {
    color: var(--color-brand-deep-burgundy);
  }

  .site-navigation__toggle {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-brand-midnight-navy);
    cursor: pointer;
  }

  .site-navigation__panel {
    position: absolute;
    z-index: calc(var(--sl-z-index-navbar) + 1);
    inset-block-start: 100%;
    inset-inline: 0;
    max-height: calc(100vh - var(--sl-nav-height));
    padding: 1rem;
    flex-direction: column;
    gap: 1.5rem;
    overflow-y: auto;
    background: var(--color-brand-warm-ivory);
    box-shadow: var(--shadow-md);
  }

  .site-navigation__links,
  .site-navigation__actions {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-navigation__link {
    display: flex;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    align-items: center;
    border-radius: var(--radius-md);
    color: var(--color-brand-midnight-navy);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
  }

  .site-navigation__link {
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .site-navigation__link:hover {
    background: var(--color-utility-white);
    color: var(--color-brand-deep-burgundy);
  }

  .site-navigation__quick-exit {
    display: inline-flex;
    width: 100%;
    min-height: 3rem;
    padding-inline: 1.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-brand-deep-burgundy);
    border-radius: var(--radius-md);
    background: var(--color-utility-white);
    color: var(--color-brand-deep-burgundy);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .site-navigation__quick-exit:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .site-navigation__search {
    width: 100%;
  }

  #site-navigation .site-navigation__search site-search {
    display: contents;
  }

  #site-navigation
    .site-navigation__search
    site-search
    > button[data-open-modal] {
    display: flex;
    width: 100%;
    min-width: 0;
    height: 3rem;
    padding-inline: 1rem;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-utility-white);
    box-shadow: var(--shadow-md);
    color: var(--color-brand-midnight-navy);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
  }

  #site-navigation
    .site-navigation__search
    site-search
    > button[data-open-modal]:hover {
    border-color: var(--color-brand-deep-burgundy);
    color: var(--color-brand-deep-burgundy);
  }

  #site-navigation
    .site-navigation__search
    site-search
    > button[data-open-modal]
    > span {
    display: block !important;
  }

  #site-navigation
    .site-navigation__search
    site-search
    > button[data-open-modal]
    > kbd {
    display: none !important;
  }

  #site-navigation a:focus-visible,
  #site-navigation button:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-navigation__link,
    .site-navigation__quick-exit {
      transition: none;
    }

    .site-navigation__quick-exit:hover {
      transform: none;
    }
  }

  @media (min-width: 40rem) {
    .site-navigation__inner {
      padding-inline: 1.5rem;
    }

    .site-navigation__panel {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 67.5rem) {
    :root {
      --sl-nav-height: 6rem;
    }

    .site-navigation__inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      padding-inline: 2rem;
      column-gap: 1rem;
    }

    .site-navigation__identity {
      min-height: 3rem;
      gap: 0.75rem;
    }

    .site-navigation__mark {
      width: 2.75rem;
      height: 2.75rem;
    }

    .site-navigation__wordmark {
      font-size: 1.375rem;
    }

    .site-navigation__toggle {
      display: none;
    }

    .site-navigation__panel {
      display: contents;
    }

    .site-navigation__links,
    .site-navigation__actions {
      width: auto;
      flex-direction: row;
      align-items: center;
    }

    .site-navigation__links {
      min-width: 0;
      gap: 0.5rem;
      justify-content: center;
    }

    .site-navigation__actions {
      flex: none;
      gap: 0.5rem;
    }

    .site-navigation__link {
      padding-inline: 0.5rem;
      font-size: 0.875rem;
      white-space: nowrap;
    }

    .site-navigation__quick-exit {
      width: auto;
      padding-inline: 1rem;
      font-size: 0.9375rem;
      white-space: nowrap;
    }

    .site-navigation__search {
      width: auto;
    }

    #site-navigation
      .site-navigation__search
      site-search
      > button[data-open-modal] {
      width: auto;
      min-width: 6.75rem;
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 75rem) {
    .site-navigation__inner {
      column-gap: 1.5rem;
    }

    .site-navigation__links {
      gap: 0.75rem;
    }

    .site-navigation__link {
      padding-inline: 0.625rem;
      font-size: 1rem;
    }
  }
</style>
